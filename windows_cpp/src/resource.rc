#include "resource.h"
#include <windows.h>

IDI_APP_ICON ICON "../resources/app_icon.ico"

IDR_TRAY_MENU MENU
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "Open Fizmoh CRM",        ID_TRAY_OPEN
        MENUITEM "Open Dashboard",         ID_TRAY_DASHBOARD
        MENUITEM "Reload App",             ID_TRAY_RELOAD
        MENUITEM SEPARATOR
        MENUITEM "Download Updates...",    ID_TRAY_DOWNLOADS
        MENUITEM SEPARATOR
        MENUITEM "Exit Fizmoh",            ID_TRAY_EXIT
    END
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Fizmoh Cloud Platform\0"
            VALUE "FileDescription",  "Fizmoh WhatsApp Cloud API & CRM Native Desktop Client\0"
            VALUE "FileVersion",      "1.1.0.0\0"
            VALUE "InternalName",     "Fizmoh\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Fizmoh. All rights reserved.\0"
            VALUE "OriginalFilename", "Fizmoh.exe\0"
            VALUE "ProductName",      "Fizmoh Desktop\0"
            VALUE "ProductVersion",   "1.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
