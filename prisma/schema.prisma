  approvedDataJson        String?  // Final user-reviewed payload
  error                   String?
  uploadedAt              DateTime @default(now())
  processedAt             DateTime?
  approvedAt              DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId, status])
}

model RestaurantAnalyticsEvent {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  eventType   String   // MENU_VIEW, ITEM_VIEW, ADD_TO_CART, CHECKOUT_START, ORDER_PLACED, WAITER_CALLED
  tableNumber String?
  productId   String?
  categoryId  String?
  orderId     String?
  sessionId   String?
  metadataJson String?
  createdAt   DateTime @default(now())

  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, branchId])
}

model RestaurantInventoryItem {
  id          String   @id @default(cuid())
