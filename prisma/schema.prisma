// Tour & Activity Booking Platform with WhatsApp Commerce
// Complete data model per BRD + additional features

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// STAFF / USERS (with roles)
// ============================================================
// ============================================================
// TENANCY
//
// One installation, many businesses. Every model below that belongs to a
// business carries a tenantId — nullable for now, because the columns land
// before the code that fills them and a not-null column on a live table would
// take the site down at the moment of the migration. Phase 1 backfills every
// existing row to the first tenant, and the constraint tightens once nothing
// writes without one.
// ============================================================

model Tenant {
  id          String   @id @default(cuid())
  /// The subdomain a workspace answers on: acme → acme.fizmoh.cloud.
  slug        String   @unique
  name        String
  /// Their own domain, once they have pointed one at us.
  customDomain String? @unique
  logoUrl     String?
  timezone    String   @default("Asia/Muscat")
  currency    String   @default("OMR")
  locale      String   @default("en")
  status      String   @default("ACTIVE") // ACTIVE, TRIALING, SUSPENDED, CANCELLED
  /// Read-only rather than deleted. A business that pays late still owns its
  /// customer list.
  suspendedAt DateTime?
  suspendedReason String?
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TenantMember[]
  subscriptions Subscription[]
  addons        TenantAddon[]
  liveChatWidgets LiveChatWidget[]

  @@index([status])
}

/// Somebody's membership of one workspace, and what they may do inside it.
///
/// Separate from Staff because the same person can belong to more than one
/// workspace, and their role is a property of the pairing rather than of them.
model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String
  role      String   @default("AGENT") // OWNER, ADMIN, AGENT, FINANCE, VIEWER
  permissions Json?
  invitedAt DateTime @default(now())
  acceptedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId])
  @@index([staffId])
}

/// What a plan sells: a set of modules and a set of ceilings.
model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Minor units, so nobody stores 9.99 as a float and loses a baisa.
  priceMonthly Int     @default(0)
  priceYearly  Int     @default(0)
  currency    String   @default("OMR")
  trialDays   Int      @default(14)
  /// ["INBOX","TOURS","VISA","APPOINTMENTS","BROADCAST","FLOWS","AI","CALLS","PAYMENTS"]
  modules     Json?
  /// { staff: 3, contacts: 5000, messagesPerMonth: 10000, numbers: 1 }
  limits      Json?
  isPublic    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

/// Optional paid capabilities that can be attached without changing a base plan.
model PlanAddon {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  module         String?
  priceMonthly   Int      @default(0)
  priceYearly    Int      @default(0)
  currency       String   @default("OMR")
  limits         Json?
  isPublic       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignments    TenantAddon[]
}

/// A tenant's explicit add-on assignment and its lifecycle.
model TenantAddon {
  id             String   @id @default(cuid())
  tenantId       String
  addonId        String
  subscriptionId String?
  status         String   @default("ACTIVE") // ACTIVE, PAST_DUE, CANCELLED
  quantity       Int      @default(1)
  currentPeriodEnd DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addon          PlanAddon @relation(fields: [addonId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, addonId])
  @@index([tenantId, status])
}

model Subscription {
  id        String   @id @default(cuid())
  tenantId  String
  planId    String
  status    String   @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELLED
  period    String   @default("MONTHLY")  // MONTHLY, YEARLY
  startedAt DateTime @default(now())
  currentPeriodEnd DateTime?
  cancelledAt DateTime?
  /// The platform gateway's own reference for this subscriber.
  gatewayCustomerId String?
  gatewayReference  String?
  customLimits      Json?
  /// Immutable entitlement snapshot captured when this subscription starts.
  /// It preserves grandfathered modules and limits across later plan edits.
  moduleSnapshot    Json?
  limitSnapshot     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]
  addons   TenantAddon[]

  @@index([tenantId, status])
}

/// What a workspace was charged, and whether it paid.
///
/// Separate from the tenants' own Payment table, which is their customers
/// paying them. This is them paying us, on the platform's own gateway, and
/// mixing the two would put our revenue in their reports.
/// A line on a subscription invoice.
///
/// The invoice carries a single `amount`, which is what the gateway charges and
/// what settlement reconciles against. Real invoices also list setup fees and
/// one-off services, so those live here: the rows are what the PDF prints, and
/// the invoice total remains the amount actually billed.
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  position    Int      @default(0)
  description String
  quantity    Int      @default(1)
  /// Minor units (baisa), matching SubscriptionInvoice.amount.
  unitAmount  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
}

model SubscriptionInvoice {
  id        String   @id @default(cuid())
  subscriptionId String
  tenantId  String
  /// Minor units, same as Plan.priceMonthly.
  amount    Int
  currency  String   @default("OMR")
  period    String   @default("MONTHLY")
  status    String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  /// What the gateway was told to call it: SUB-xxxxx.
  reference String   @unique
  gatewayReference String?
  paidAt    DateTime?
  periodStart DateTime @default(now())
  periodEnd   DateTime?
  /// Dunning escalation: 0 = none, 1 = first reminder, 2 = second, 3 = final warning.
  dunningStep  Int       @default(0)
  lastDunnedAt DateTime?
  nextDunAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]

  @@index([tenantId, status])
  @@index([status, nextDunAt])
}

/// What a tenant has consumed this month, against the plan's ceilings.
model UsageCounter {
  id        String   @id @default(cuid())
  tenantId  String
  /// MESSAGES, CAMPAIGNS, AI_REPLIES — the metered things.
  metric    String
  /// The month this counts, as 2026-08.
  period    String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, metric, period])
}

/// Immutable platform-level history for plan, add-on and entitlement changes.
model PlatformAuditEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  actorStaffId String?
  action     String
  entity     String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

/// Durable delivery record for Meta, AmwalPay and tenant webhook retries.
model WebhookDelivery {
  id          String   @id @default(cuid())
  tenantId    String?
  provider    String
  eventType   String
  externalId  String?
  status      String   @default("RECEIVED") // RECEIVED, PROCESSED, FAILED, RETRYING, DEAD
  attempts    Int      @default(0)
  nextRetryAt DateTime?
  payload     Json?
  response    Json?
  lastError   String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([provider, externalId])
  @@index([status, nextRetryAt])
}

model Staff {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String
  role          String   @default("CHAT_AGENT") // SUPER_ADMIN, OPS_ADMIN, FINANCE, CHAT_AGENT, MARKETING, GUIDE
  avatar        String?
  address       String?
  isActive      Boolean  @default(true)
  workingHours  String?  // JSON: { mon: {start,end}, ... }
  assignedChats Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordersVerified     Payment[]    @relation("PaymentVerifier")
  conversationsOwned Conversation[] @relation("AssignedStaff")
  notes              StaffNote[]
  auditLogs          AuditLog[]
  messages           Message[]    @relation("MessageSender")
  orders             Order[]      @relation("OrderCreatedBy")
  devices            DeviceToken[]
  memberships        TenantMember[]
}

// ============================================================
// CUSTOMERS
// ============================================================
model Customer {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id              String   @id @default(cuid())
  name            String?
  /*
   * Unique within a business, not across the installation.
   *
   * A global unique here meant two businesses could not both have the same
   * customer — and the same person very often deals with two of them. The
   * second business's webhook would either fail outright or, worse, attach
   * their conversation to the first business's customer record.
   */
  email           String?
  phone           String
  /// Raw Messenger PSID or Instagram-scoped user id, for a customer with no
  /// phone number. `phone` still holds a synthetic "social:<channel>:<id>"
  /// placeholder for such a customer — see the Social Automation note above
  /// — so every existing WhatsApp code path that reads `phone` as a real,
  /// always-present string keeps working unchanged. This is the real id.
  socialId        String?
  channel         String   @default("WHATSAPP") // WHATSAPP, FACEBOOK, INSTAGRAM
  whatsappOptIn   Boolean  @default(true)
  facebookOptIn   Boolean  @default(true)
  instagramOptIn  Boolean  @default(true)
  socialUsername  String?  // @username or profile name/handle
  emailOptIn      Boolean  @default(false)
  // Consent log — required by BRD §7 (PDPL/GDPR) and Meta messaging policy.
  optInSource     String?  // WHATSAPP_INBOUND, FACEBOOK_INBOUND, INSTAGRAM_INBOUND, WEBSITE, IMPORT, STAFF
  optInAt         DateTime?
  optOutAt        DateTime?
  optOutReason    String?
  preferredLang   String   @default("en") // en | ar
  preferredCurrency String @default("OMR")
  tags            Json?    // [string]
  customFields    Json?
  /*
   * The sales side of a contact.
   *
   * A list of names with an order count is a customer table, not a CRM. What
   * makes it one is knowing where somebody is in your pipeline, whose job it
   * is to move them along, and when they were last spoken to — the three
   * questions asked in every pipeline meeting, previously answerable only by
   * scrolling a conversation.
   */
  stage           String   @default("NEW") // NEW, ENGAGED, QUALIFIED, CUSTOMER, REPEAT, LOST
  ownerStaffId    String?
  source          String?  // WHATSAPP, SHOP, IMPORT, STAFF, CAMPAIGN, REFERRAL
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  followUpNote    String?
  lifetimeValue   Float    @default(0)
  loyaltyPoints   Int      @default(0)
  loyaltyTier     String   @default("BRONZE") // BRONZE, SILVER, GOLD
  totalBookings   Int      @default(0)
  totalSpent      Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  payments        Payment[]
  reviews         Review[]
  conversations   Conversation[]
  vouchers        Voucher[]
  messages        Message[]
  consentLogs     ConsentLog[]
  waitlists       Waitlist[]
  auditLogs       AuditLog[] @relation("CustomerAuditLogs")
  leads           Lead[]
  appointments   Appointment[]
  visaEnquiries  VisaEnquiry[]

  contactNotes    ContactNote[]
  crmTasks        CrmTask[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, socialId])
  @@index([tenantId])
  @@index([phone])
  @@index([tenantId, stage])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, channel])
}

/// A note written about a contact, as opposed to about one conversation.
///
/// StaffNote is attached to a conversation and disappears from view the moment
/// the thread scrolls. Anything worth knowing next time — "prefers Arabic",
/// "asked us to call after Ramadan", "disputed an invoice in March" — belongs
/// to the person, not to the thread it happened to be mentioned in.
model ContactNote {
  id         String   @id @default(cuid())
  tenantId   String?
  customerId String
  staffId    String?
  body       String
  /// NOTE, CALL, MEETING, EMAIL — what happened, so a timeline reads properly.
  kind       String   @default("NOTE")
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@index([customerId, createdAt])
}

// ============================================================
// TOURS / SERVICES
// ============================================================
model Tour {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id              String   @id @default(cuid())
  /// Unique per business. Two operators both selling a "desert-safari" is the
  /// normal case, not a conflict.
  slug            String
  name            String
  nameAr          String?
  description     String
  descriptionAr   String?
  category        String   // e.g., Adventure, Cultural, Water Sports, Desert
  city            String
  location        String?
  latitude        Float?
  longitude       Float?
  basePrice       Float
  childPrice      Float?
  groupPrice      Float?
  currency        String   @default("OMR")
  durationHours   Float
  difficulty      String   @default("EASY") // EASY, MODERATE, HARD
  capacityPerSlot Int      @default(8)
  pricingTiers    Json?    // [{name, price, type}]
  media           Json?    // [{type, url, alt}]
  itinerary       Json?    // [{time, title, description}]
  inclusions      Json?    // [string]
  exclusions      Json?    // [string]
  whatToBring     Json?    // [string]
  meetingPoint    String?
  meetingLat      Float?
  meetingLng      Float?
  status          String   @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  featured        Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  seoTitle        String?
  seoDescription  String?
  cancellationPolicy String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  slots     Slot[]
  orders    Order[]
  addOns    AddOn[]
  reviews   Review[]
  waitlists Waitlist[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([slug])
}

model AddOn {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id        String  @id @default(cuid())
  tourId    String
  name      String
  price     Float
  type      String  @default("FLAT") // FLAT, PER_PAX
  isActive  Boolean @default(true)
  tour      Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

// ============================================================
// SLOTS & AVAILABILITY
// ============================================================
model BotSeatHold {
  id String @id @default(cuid())
  tenantId String
  slotId String
  remaining Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([tenantId, expiresAt])
  @@index([slotId])
}

model Slot {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id           String   @id @default(cuid())
  tourId       String
  date         DateTime
  startTime    String   // "09:00"
  endTime      String?
  capacity     Int      @default(8)
  seatsBooked  Int      @default(0)
  seatsHeld    Int      @default(0)
  resourceId   String?  // guide/vehicle assignment
  status       String   @default("OPEN") // OPEN, FULL, CLOSED, BLACKOUT
  priceOverride Float?  // seasonal/dynamic pricing
  isRecurring  Boolean  @default(false)
  recurringId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tour       Tour       @relation(fields: [tourId], references: [id], onDelete: Cascade)
  orders     Order[]
  waitlists  Waitlist[]

  @@unique([tourId, date, startTime])

  @@index([tenantId])
}

// ============================================================
// ORDERS / BOOKINGS
// ============================================================
model Order {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  customerId     String
  tourId         String
  slotId         String
  paxAdult       Int      @default(1)
  paxChild       Int      @default(0)
  // Infants travel free and do not occupy a seat, but the operator needs the
  // count for life jackets, car seats and headcount at the meeting point.
  paxInfant      Int      @default(0)
  addOns         Json?    // [{addOnId, name, price, qty}]
  customerName   String
  customerPhone  String
  customerEmail  String?
  pickupLocation String?
  specialRequests String?
  subtotal       Float
  discount       Float    @default(0)
  taxAmount      Float    @default(0) // 5% VAT
  totalAmount    Float
  paymentMethod  String   // AMWALPAY, BANK_TRANSFER, PAYMOB
  paymentStatus  String   @default("PENDING") // PENDING, SUBMITTED, VERIFIED, PAID, FAILED, REFUNDED
  orderStatus    String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAYMENT_SUBMITTED, CONFIRMED, COMPLETED, CANCELLED, REFUNDED, NO_SHOW
  channel        String   @default("WEB") // WEB, WHATSAPP, ADMIN, API
  couponCode     String?
  createdById    String?  // staff who created (if admin/whatsapp)
  confirmedAt    DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  // Automation idempotency — set once when the scheduled job sends, so a
  // re-run of the cron never messages the customer twice.
  recoverySentAt DateTime?
  reminderSentAt DateTime?
  reviewRequestSentAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  tour       Tour     @relation(fields: [tourId], references: [id])
  slot       Slot     @relation(fields: [slotId], references: [id])
  payments   Payment[]
  vouchers   Voucher[]
  reviews    Review[]
  createdBy  Staff?   @relation("OrderCreatedBy", fields: [createdById], references: [id])
  auditLogs  AuditLog[] @relation("OrderAuditLogs")

  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])

  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

// ============================================================
// PAYMENTS
// ============================================================
model Payment {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id               String   @id @default(cuid())
  orderId          String
  customerId       String?
  method           String   // AMWALPAY, BANK_TRANSFER, PAYMOB
  amount           Float
  currency         String   @default("OMR")
  status           String   @default("PENDING") // PENDING, SUBMITTED, VERIFIED, APPROVED, REJECTED, FAILED, REFUNDED
  gatewayReference String?  // AmwalPay / Paymob transaction ID
  bankReference    String?  // customer-submitted transaction ref
  bankName         String?
  transferDate     DateTime?
  screenshotUrl    String?  // payment proof image
  screenshotOcr    Json?    // VLM/OCR analysis result
  fraudScore       Float?   @default(0)
  fraudFlags       Json?
  verifiedById     String?
  verifiedAt       DateTime?
  rejectionReason  String?
  verifierComment  String?
  webhookPayload   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  verifier Staff?    @relation("PaymentVerifier", fields: [verifiedById], references: [id])
}

model BankAccount {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id          String   @id @default(cuid())
  /// "BANK" for a normal account transfer, "PHONE" for a transfer sent to a
  /// mobile number. A phone row uses accountName for the name the number is
  /// registered under and accountNumber for the number itself; the bank,
  /// IBAN, SWIFT and branch columns do not apply to it.
  type        String   @default("BANK")
  bankName    String
  accountName String
  accountNumber String
  iban        String?
  branch      String?
  swiftCode   String?
  currency    String   @default("OMR")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// VOUCHERS (QR check-in)
// ============================================================
model Voucher {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id          String   @id @default(cuid())
  voucherCode String   @unique
  orderId     String
  customerId  String
  qrData      String
  pdfUrl      String?
  status      String   @default("VALID") // VALID, USED, EXPIRED, CANCELLED
  checkedInAt DateTime?
  checkedInBy String?
  createdAt   DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
}

// ============================================================
// WHATSAPP CONVERSATIONS & MESSAGES
// ============================================================
model Conversation {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id              String   @id @default(cuid())
  customerId      String?
  customerPhone   String
  customerName    String?
  assignedStaffId String?
  status          String   @default("OPEN") // OPEN, PENDING, RESOLVED, CLOSED
  botActive       Boolean  @default(true)
  labels          Json?    // [string]
  lastMessageAt   DateTime?
  lastMessageText String?
  // Meta only allows freeform messages within 24h of the customer's last
  // inbound message. Outside it, only approved templates may be sent.
  sessionExpiresAt DateTime?
  // Guided booking flow position and selections so far. Null when the
  // customer is in free conversation with the assistant.
  bookingState    Json?
  // Position and answers inside an operator-authored flow that asks questions.
  // Separate from bookingState so the tour flow and a custom flow cannot
  // overwrite each other.
  flowState       Json?
  unreadCount     Int      @default(0)
  channel         String   @default("WHATSAPP")
  /// Raw PSID/IGSID for a FACEBOOK/INSTAGRAM conversation — see the Social
  /// Automation schema note. Null for WhatsApp, where customerPhone is real.
  externalUserId  String?
  /// Set by a staff member (or the engine, for a low-confidence AI moment) to
  /// take a conversation off auto-reply without disabling the channel
  /// entirely — "pause automation" / "resume automation" from the inbox.
  automationPaused Boolean @default(false)
  sentiment       String?  // POSITIVE, NEUTRAL, NEGATIVE
  intent          String?  // detected intent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer    Customer?  @relation(fields: [customerId], references: [id])
  assignedStaff Staff?   @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  messages    Message[]
  notes       StaffNote[]
  /// Half-finished appointment booking. Separate from bookingState so a
  /// customer part-way through booking a tour cannot have it overwritten by
  /// starting an appointment, or the reverse.
  appointmentState Json?
  /// Half-finished visa enquiry, kept apart from the other flows.
  visaState Json?

  /// Where a patient has got to in the hospital booking flow.
  ///
  /// This lived in a Map in process memory, so every deploy dropped patients
  /// mid-registration and it could not survive more than one app process — of
  /// which this installation runs several. Stored beside the other flow states
  /// so it behaves like them, with its own expiry inside the payload.
  hospitalState Json?

  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model Message {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id              String   @id @default(cuid())
  externalId      String?  @unique // WhatsApp wamid — dedupes Meta webhook retries
  conversationId  String
  customerId      String?
  senderId        String?
  direction       String   // INBOUND, OUTBOUND, BOT
  type            String   @default("TEXT") // TEXT, IMAGE, VIDEO, DOCUMENT, AUDIO, INTERACTIVE, TEMPLATE, LOCATION, BUTTONS, LIST
  content         String
  mediaUrl        String?
  caption         String?
  templateName    String?
  interactiveData Json?    // buttons, list items
  status          String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  isAiGenerated   Boolean  @default(false)
  aiSuggestions   Json?    // suggested replies for agents
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id])
  sender       Staff?       @relation("MessageSender", fields: [senderId], references: [id])

  @@index([tenantId])
  @@index([conversationId, createdAt])
}

/**
 * An enquiry captured by a flow that asks questions.
 *
 * Kept apart from Order because these are not bookings — they are people who
 * answered a form over WhatsApp and want to be contacted. The answers are held
 * as given, since a flow's questions are authored by the operator and change.
 */
model Lead {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id             String   @id @default(cuid())
  conversationId String?
  customerId     String?
  flowId         String?
  flowName       String?
  answers        Json     // { fieldName: answer }
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, WON, LOST
  assignedStaffId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model StaffNote {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id             String   @id @default(cuid())
  conversationId String
  staffId        String
  content        String
  isPrivate      Boolean  @default(true)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id])
}

model CannedResponse {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id       String   @id @default(cuid())
  title    String
  content  String
  category String?
  shortcut String?  // e.g. "/greeting"
  lang     String   @default("en")
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Label {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id      String   @id @default(cuid())
  name    String
  color   String   @default("emerald")
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
