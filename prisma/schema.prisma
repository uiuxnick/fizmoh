model AptCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  nameAr      String?
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services    AptService[]

  @@index([tenantId])
}

model AptService {
  id                 String   @id @default(cuid())
  tenantId           String
  categoryId         String?
  name               String
  nameAr             String?
  description        String?
  durationMins       Int      @default(30)
  bufferMins         Int      @default(0)
  price              Float    @default(0)
  currency           String   @default("OMR")
  onlineInPerson     String   @default("IN_PERSON") // IN_PERSON, ONLINE, HOME_VISIT
  isBookingEnabled   Boolean  @default(true)
  isWhatsappEnabled  Boolean  @default(true)
  status             String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category           AptCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
