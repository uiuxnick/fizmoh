  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders          KitchenOrder[]
  reservations    TableReservation[]
  qrTokens        RestaurantQrToken[]
  waiterRequests  RestaurantWaiterRequest[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([token])
}

model MenuCategory {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  menuId        String?
  name          String
  nameAr        String?
  description   String?
  descriptionAr String?
  imageUrl      String?
  icon          String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  menu          RestaurantMenu? @relation(fields: [menuId], references: [id], onDelete: SetNull)
  items         MenuItem[]

  @@index([tenantId])
  @@index([tenantId, menuId])
}

model MenuItem {
  id                  String   @id @default(cuid())
  tenantId            String
  branchId            String?
  menuId              String?
  categoryId          String
  name                String
  nameAr              String?
  description         String?
  descriptionAr       String?
  price               Float
  salePrice           Float?
  currency            String   @default("OMR")
  imageUrl            String?
  allergens           String?
  prepTimeMinutes     Int      @default(15)
  isAvailable         Boolean  @default(true)
  isSoldOut           Boolean  @default(false)
  isFeatured          Boolean  @default(false)
  isVegetarian        Boolean  @default(false)
  isVegan             Boolean  @default(false)
  isGlutenFree        Boolean  @default(false)
  calories            Int?
  sku                 String?
  sortOrder           Int      @default(0)
  availableFrom       String?  // e.g. "12:00"
  availableTo         String?  // e.g. "23:00"
  tagsJson            String?  // Stored JSON array ["Chef Special", "Spicy"]
  variantsJson        String?  // Stored JSON array [{id, name, nameAr, price}]
  modifiersJson       String?  // Stored JSON array [{id, name, min, max, required, options: [{id, name, price}]}]
  addonsJson          String?  // Backward-compatible stored JSON array [{name, price}]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category            MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventory           RestaurantInventoryItem[]

  @@index([tenantId, categoryId])
  @@index([tenantId, branchId])
}

model KitchenOrder {
  id                  String   @id @default(cuid())
  tenantId            String
  branchId            String?
  orderNumber         String?  // Human readable, e.g. "#1024"
  publicToken         String?  // Secure public token for customer live tracking
  tableId             String?
  tableNumber         String?
  roomNumber          String?
  orderType           String   @default("DINE_IN") // DINE_IN, TAKEAWAY, DELIVERY, ROOM_SERVICE
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  customerId          String?
  deliveryAddress     String?
  itemsJson           String   // Stored array of items [{id, name, qty, price, notes, variant, modifiers}]
  totalAmount         Float
  currency            String   @default("OMR")
  status              String   @default("PENDING") // PENDING, ACCEPTED, PREPARING, READY, SERVED, COMPLETED, CANCELLED
  specialNotes        String?
  subtotalAmount      Float?
  taxAmount           Float?
  discountAmount      Float?
  serviceChargeAmount Float?   @default(0)
  deliveryChargeAmount Float?  @default(0)
  tipAmount           Float?   @default(0)
  taxRuleId           String?
  discountId          String?

  /// Card payment, for orders taken over WhatsApp rather than at the table.
  paymentStatus       String   @default("UNPAID") // UNPAID, PENDING, PAID, FAILED
  paymentMethod       String?  // AMWALPAY_ONLINE, PAYMOB_ONLINE, CASH, CARD_AT_VENUE, ROOM_CHARGE
  paymentRef          String?  // gateway reference, for reconciliation

  statusHistoryJson   String?  // JSON array [{status, timestamp, note}]
  acceptedAt          DateTime?
  preparingAt         DateTime?
  readyAt             DateTime?
  servedAt            DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch              RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  table               RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  taxRule             RestaurantTaxRule? @relation(fields: [taxRuleId], references: [id], onDelete: SetNull)
  discount            RestaurantDiscount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, publicToken])
}

model RestaurantWaiterRequest {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String?
  tableId         String?
  tableNumber     String?
  roomNumber      String?
  requestType     String   @default("ASSISTANCE") // WATER, BILL, CUTLERY, CLEAN_TABLE, ASSISTANCE, OTHER
  message         String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, RESOLVED, CANCELLED
  assignedStaffId String?
  requestedAt     DateTime @default(now())
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  table           RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  branch          RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, status])
  @@index([tenantId, status])
}

model RestaurantMenuImport {
  id                      String   @id @default(cuid())
  tenantId                String
  branchId                String?
  fileName                String
  fileUrl                 String
  fileType                String   // pdf, image/jpeg, image/png
  fileSize                Int      @default(0)
  status                  String   @default("UPLOADED") // UPLOADED, PROCESSING, READY_FOR_REVIEW, APPROVED, FAILED
  extractedCategoriesCount Int     @default(0)
  extractedProductsCount   Int     @default(0)
  warningsCount           Int      @default(0)
  extractedDataJson       String?  // Structured extracted menu
