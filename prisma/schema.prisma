  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  bookings     HospChemoBooking[]

  @@index([tenantId])
}

model HospChemoBooking {
  id            String    @id @default(cuid())
  tenantId      String
  bookingRef    String    @unique // CHEMO-260817-007
  patientId     String
  doctorId      String
  bedId         String
  sessionId     String?
  bookingDate   DateTime
  status        String    @default("CONFIRMED") // CONFIRMED|CHECKED_IN|OCCUPIED|TREATMENT_STARTED|COMPLETED|CANCELLED|RESCHEDULED
  source        String    @default("WEB") // WEB|WHATSAPP|ADMIN|WALK_IN
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patient       HospPatient @relation(fields: [patientId], references: [id])
  doctor        HospDoctor  @relation(fields: [doctorId], references: [id])
  bed           HospBed     @relation(fields: [bedId], references: [id])
  session       HospTreatmentSession? @relation(fields: [sessionId], references: [id])

  @@unique([bedId, bookingDate, sessionId]) // prevents double-booking
  @@index([tenantId, bookingDate])
  @@index([patientId])
}

model HospDoctorAppointment {
  id              String      @id @default(cuid())
  tenantId        String
  appointmentRef  String      @unique // APT-260817-1045
  patientId       String
  doctorId        String
  appointmentDate DateTime
  appointmentTime String      // "10:30"
  status          String      @default("CONFIRMED") // PENDING|CONFIRMED|CHECKED_IN|COMPLETED|CANCELLED|NO_SHOW|RESCHEDULED
  source          String      @default("WEB")
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  patient         HospPatient @relation(fields: [patientId], references: [id])
  doctor          HospDoctor  @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, appointmentDate, appointmentTime])
  @@index([tenantId, appointmentDate])
}

model HospWaitlist {
  id            String      @id @default(cuid())
  tenantId      String
  patientId     String
  doctorId      String?
  preferredDate DateTime
  wardType      String?
  mobile        String
  status        String      @default("WAITING") // WAITING|NOTIFIED|BOOKED|EXPIRED
  createdAt     DateTime    @default(now())
  patient       HospPatient @relation(fields: [patientId], references: [id])

  @@index([tenantId, preferredDate])
}

model HospSettings {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  hospitalName      String   @default("Kauvery Hospital")
  sessionMode       String   @default("SESSION") // DAY | SESSION
  holdDurationMins  Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Platform Control — Support Tickets
// ─────────────────────────────────────────────────────────────

/// Bi-directional support tickets between tenants and platform operators.
model SupportTicket {
  id              String    @id @default(cuid())
  tenantId        String?
  /// Auto-generated reference, e.g. FZ-0001.
  reference       String    @unique
  subject         String
  body            String
  /// LOW, MEDIUM, HIGH, URGENT
  priority        String    @default("MEDIUM")
  /// OPEN, IN_PROGRESS, WAITING, RESOLVED, CLOSED
  status          String    @default("OPEN")
  /// PLATFORM, WHATSAPP, EMAIL
  channel         String    @default("PLATFORM")
  /// Staff who created the ticket (tenant agent or platform operator).
  createdById     String
  /// Platform operator assigned to handle this ticket.
  assignedStaffId String?
  /// Optional link to a WhatsApp conversation for context.
  conversationId  String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  replies SupportTicketReply[]

  @@index([tenantId, status])
  @@index([assignedStaffId])
  @@index([status, priority])
  @@index([createdAt])
}

/// Threaded replies on a support ticket.
model SupportTicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  staffId   String
  body      String
  /// Internal notes are visible only to platform operators, not tenant staff.
  isInternal Boolean @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Platform Control — Announcements
// ─────────────────────────────────────────────────────────────

/// Platform-wide announcements displayed as in-app banners in tenant workspaces.
model PlatformAnnouncement {
  id              String    @id @default(cuid())
  title           String
  body            String
  /// INFO, WARNING, MAINTENANCE, FEATURE
  type            String    @default("INFO")
  /// ALL, or JSON array of plan slugs / tenant IDs for targeted delivery.
  targetAudience  String    @default("ALL")
  publishedAt     DateTime?
  expiresAt       DateTime?
  /// Platform operator who created this announcement.
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([publishedAt])
  @@index([type])
}



/// A piece of follow-up work against a contact.
///
/// `Customer.nextFollowUpAt` held one date and one note, so a contact could
/// only ever be waiting on a single thing and nothing recorded whether it was
/// done. Real follow-up is several open items, each owned by somebody, each
/// with its own due date — which is what makes a "my day" list possible and
/// what stops a promised call quietly disappearing.
model CrmTask {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String?
  title       String
  notes       String?
  /// CALL, MESSAGE, QUOTE, MEETING, FOLLOW_UP, OTHER
  type        String    @default("FOLLOW_UP")
  /// LOW, NORMAL, HIGH
  priority    String    @default("NORMAL")
  dueAt       DateTime?
  /// Who owes the work. Null means unassigned and shows in the team queue.
  assigneeId  String?
  completedAt DateTime?
  completedBy String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, completedAt, dueAt])
  @@index([tenantId, assigneeId, completedAt])
  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Digital QR Addons — smart QR review & reputation management.
//
// A physical QR code (table tent, receipt, counter stand) leads to a mobile
// page where a customer rates their experience. 4-5 star ratings are offered
// AI-drafted review suggestions and a link to post on Google; 1-3 star
// ratings go to a private feedback queue instead of Google — never
// suppressing a real complaint, just not asking to publish it. The AI only
// ever rephrases what the customer actually said; see reviewAiSuggest() in
// src/lib/review-ai.ts for the enforced system prompt.
//
// Every table is tenant-scoped and picked up automatically by the tenant
// extension in src/lib/db.ts (any model with a `tenantId` column is scoped).
// ─────────────────────────────────────────────────────────────────────────

/// One physical-QR review campaign — e.g. "Main Branch — Table Reviews".
model QrCampaign {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, EXPIRED, ARCHIVED
  language    String   @default("en")    // default language for the customer page

  /// The business's own official Google review link (Business Profile "write
  /// a review" URL). Pasted by the operator — Google's Business Profile APIs
  /// do not return this URL for any connected location, with or without API
  /// access approval, so connecting an account (see GoogleIntegration) never
  /// fills this in automatically. It stays a manual field.
  googleReviewUrl String?

  /// Advisory only — see confirm/route.ts. Below this, the customer is also
  /// offered a private-feedback link alongside the Google button, never
  /// instead of it. Every rating can always reach Google.
  ratingThreshold Int @default(4)

  aiTone          String  @default("friendly") // friendly, professional, casual
  aiSuggestionCount Int   @default(3)          // 2-4 per the spec

  /// Optional — most workspaces have one location and never set this.
  locationId String?

  /// Which connected Google Business Profile location this campaign reports
  /// on, e.g. "locations/12345". Set from the picker once a GoogleIntegration
  /// exists; null means the campaign has no Google location linked yet.
  googleLocationId   String?
  googleLocationName String?
  /// Pulled from Google's own Reviews API (v4) — never computed or guessed
  /// from ReviewSession data, which is this app's own funnel, not Google's
  /// public rating. Null until the first successful sync.
  googleAverageRating   Float?
  googleReviewCount     Int?
  googleRatingSyncedAt  DateTime?
  /// Set when a sync attempt fails — most often "not yet approved" while the
  /// platform's Business Profile API access request is pending with Google.
  googleSyncError       String?

  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location QrLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  qrCodes  QrCode[]
  sessions ReviewSession[]

  @@index([tenantId, status])
  @@index([tenantId, locationId])
}

/// One physical placement of a QR code (a table, the entrance, a receipt).
/// Each has its own scannable token and its own analytics.
model QrCode {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  label      String   // "Table 01", "Main Entrance", "Receipt"
  /// The unguessable path segment the printed QR encodes: /r/<token>.
  token      String   @unique
  isActive   Boolean  @default(true)

  /// Free-form print design — layers (text/shape/image/qr) with percentage
  /// position and size, from the full-page canvas editor. Null means nobody
  /// has customised it yet, and the editor starts from its own built-in
  /// default layout. The QR layer's own position/size lives in here like any
  /// other layer, but is always redrawn on top at render time regardless of
  /// its stored order — see qr-canvas-design.ts — so a design can be rearranged
  /// freely without ever risking a layer printed over the code itself.
  design Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign QrCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scans    QrScan[]
  sessions ReviewSession[]

  @@index([tenantId, campaignId])
}

/// One scan of one QR code. Anonymous — no personal data, a hashed
/// fingerprint only, kept solely to tell a repeat scan from a first one.
model QrScan {
  id           String   @id @default(cuid())
  tenantId     String
  qrCodeId     String
  /// SHA-256 of IP + user-agent + campaign — enough to dedupe "unique" scans
  /// without storing anything that identifies a person.
  fingerprint  String
  isUnique     Boolean  @default(true)
  userAgent    String?
  scannedAt    DateTime @default(now())

  qrCode QrCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([tenantId, qrCodeId, scannedAt])
  @@index([fingerprint])
}

/// One customer's journey through the review flow, from scan to (maybe)
/// Google. This is the funnel: every stage records its own timestamp so the
/// dashboard's drop-off numbers come from real transitions, not estimates.
model ReviewSession {
  id         String   @id @default(cuid())
  tenantId   String
  campaignId String
  qrCodeId   String

  status String @default("STARTED")
  // STARTED, RATED, INPUT_GIVEN, AI_GENERATED, SUGGESTION_SELECTED,
  // EDITED, CONFIRMED, ROUTED_GOOGLE, ROUTED_PRIVATE

  rating      Int?     // 1-5, set only once the customer actively picks one
  inputTags   Json?    // ["Food","Service",...]
  inputText   String?  // optional free text, customer's own words

  aiGeneratedAt DateTime?
  selectedSuggestionId String?
  editedText    String?  // if the customer changed the selected suggestion
  finalText     String?  // what was actually shown at final confirmation

  /// NONE until the customer clicks Post on Google. There is no supported way
  /// to verify the actual submission from here, so this never claims more
  /// than "we sent them and they clicked" — see review-ai.ts docs.
  googleStatus     String   @default("NONE") // NONE, CTA_CLICKED
  googleClickedAt  DateTime?

  ratedAt      DateTime?
  confirmedAt  DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign    QrCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  qrCode      QrCode     @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  suggestions ReviewSuggestion[]
  feedback    PrivateFeedback?

  @@index([tenantId, campaignId, createdAt])
  @@index([tenantId, status])
}

/// One AI-drafted option shown to the customer. The customer must explicitly
/// select one — nothing here is ever auto-chosen.
model ReviewSuggestion {
  id        String   @id @default(cuid())
  tenantId  String
  sessionId String
  style     String   // NATURAL, SHORT, DETAILED
  text      String
  isSelected Boolean @default(false)
  createdAt DateTime @default(now())

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
}

/// A 1-3 star (below threshold) submission — kept private, routed to the
/// business's own queue instead of a public platform.
model PrivateFeedback {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String   @unique
  rating      Int
  category    String?
  feedbackText String?
  contactName  String?
  contactPhone String?
  contactEmail String?
  wantsCallback Boolean @default(false)

  status       String   @default("NEW") // NEW, PENDING, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  assignedToId String?
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// One physical location/branch for Digital QR Addons — optional. A
/// single-location business (most Fizmoh tenants today) never needs one;
/// campaigns and QR codes work exactly the same with no location assigned.
/// Kept scoped to this module rather than a shared app-wide entity, the same
/// way Appointments already keeps its own AptBranch — a generic location
/// model touching every module is a much larger, riskier change than this one
/// module needing branch comparison.
model QrLocation {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns QrCampaign[]

  @@index([tenantId])
}

/// One workspace's connection to a real Google account for Business Profile
/// data (average rating, review count — never a substitute for the manual
/// googleReviewUrl, which Google's own API does not expose).
///
/// One row per tenant: a workspace connects one Google account, the same way
/// the existing Calendar connect (google-oauth.ts) works, but kept in its own
/// table rather than SystemSetting because there is real structured state to
/// track here — which account, which API calls have actually succeeded — not
/// just a token string.
///
/// Tokens are encrypted at rest via secret-box.ts, same as every other
/// runtime-written credential in this app.
model GoogleIntegration {
  id       String @id @default(cuid())
  tenantId String @unique

  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime?

  googleEmail       String?
  googleAccountId   String? // e.g. "accounts/12345" from the Account Management API
  googleAccountName String?

  /// CONNECTED | ERROR | DISCONNECTED. ERROR means the last API call failed —
  /// most commonly because the platform's Business Profile API access request
  /// has not yet been approved by Google. The OAuth grant itself still holds.
  status     String    @default("CONNECTED")
  lastError  String?
  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ─── Google review auto-reply ──────────────────────────────────────────────
// Reuses GoogleIntegration for the OAuth grant and QrCampaign.googleLocationId
// for which location a workspace has connected — no second connect flow, no
// second location picker. This only adds what those two didn't already cover:
// how a workspace wants replies generated, and the reviews/replies themselves.

/// One row per tenant. A tenant with no row here has never opened the
/// settings screen — auto-reply is off, same as if `enabled` were false.
model ReviewReplySettings {
  id       String @id @default(cuid())
  tenantId String @unique

  enabled Boolean @default(false)
  /// MANUAL_APPROVAL | AUTOMATIC | DRAFT_ONLY. Only AUTOMATIC ever publishes
  /// without a person clicking Approve — see review-reply-engine.ts.
  mode String @default("MANUAL_APPROVAL")

  tone       String  @default("professional") // professional | warm | formal | casual | luxury | custom
  customTone String?
  replyLength String @default("medium") // short | medium | detailed

  delayMode          String  @default("immediate") // immediate | delay | business_hours | custom_schedule
  delayMinutes       Int?
  businessHoursStart String? // "09:00", tenant's own timezone below
  businessHoursEnd   String? // "18:00"
  timezone           String  @default("Asia/Muscat")

  /// AUTOMATIC mode only: at/above this rating may auto-publish. Below it
  /// always requires approval, in every mode — this is the "1-3 star needs
  /// approval" rule from spec section 3, not just a suggestion.
  autoPublishMinRating  Int @default(4)
  requireApprovalBelow  Int @default(4)

  /// Extra phrases beyond the hardcoded defaults (refund/legal/safety/
  /// discrimination/urgent) that force PENDING_APPROVAL regardless of mode.
  escalationKeywords Json?
  signature          String?
  /// Reply language(s) — the generator replies in the review's own language
  /// when it appears here, otherwise the first entry.
  languages Json? // ["en"]
  /// Optional fixed template overrides, keyed by rating band ("5","4","3","1-2").
  templates    Json?
  excludedWords Json?
  maxRepliesPerDay Int @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One fetched Google review. `googleReviewName` (Google's own resource name,
/// "accounts/*/locations/*/reviews/*") is the true dedup key — re-fetching the
/// same review twice must never create two rows or send two replies.
model GoogleReview {
  id               String @id @default(cuid())
  tenantId         String
  googleLocationId String // "locations/12345" — matches QrCampaign.googleLocationId
  googleReviewName String @unique

  reviewerName String?
  /// 1-5, or 0 for a rating Google reports as unspecified (a very old or
  /// emoji-only review with no parseable star value) — never guessed.
  rating  Int
  comment String?

  createTime DateTime
  updateTime DateTime?
  /// True the moment this review already carried a reply when fetched — a
  /// business that replied on Google's own app directly, not through this
  /// module. Never overwritten or duplicated.
  alreadyRepliedOnGoogle Boolean @default(false)

  fetchedAt DateTime @default(now())

  reply ReplyLog?

  @@index([tenantId, googleLocationId])
  @@index([tenantId, rating])
}

/// The reply lifecycle for one review. One-to-one with GoogleReview.
model ReplyLog {
  id       String       @id @default(cuid())
  tenantId String
  reviewId String       @unique
  review   GoogleReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// NEW → DRAFT/PENDING_APPROVAL → APPROVED → PUBLISHED
  ///                              ↘ FAILED (retried) / SKIPPED / ESCALATED
  status String @default("NEW")

  generatedText    String?
  editedText       String?
  /// What was or will be sent — editedText if a person changed it, otherwise generatedText.
  finalText        String?
  escalationReason String?
  skipReason       String?
  failReason       String?
  retryCount       Int      @default(0)
  nextRetryAt      DateTime?

  approvedByStaffId String?
  approvedAt        DateTime?
  scheduledFor      DateTime? // delay / business-hours modes
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, publishedAt])
}

// ─── Facebook & Instagram Automation (paid add-on) ─────────────────────────
//
// Deliberately reuses Conversation, Message, Lead and StaffNote as-is —
// Conversation/Message already carry a `channel` column (WhatsApp's own
// multi-channel-readiness, never previously used) and Message's `externalId`
// unique constraint is the same dedup key WhatsApp's wamid uses, so a
// Messenger mid or Instagram message id gets the same duplicate-prevention
// for free. Nothing about WhatsApp's own rows or code changes.
//
// One real schema decision: Messenger/Instagram customers have no phone
// number, only a PSID/IGSID. Rather than widen Customer.phone /
// Conversation.customerPhone to nullable — which would ripple `string | null`
// through every WhatsApp file that assumes a real phone string today, the
// exact "disturb existing WhatsApp automation" this module must not do —
// a social-only customer gets a synthetic, still-non-null placeholder in
// those columns ("social:facebook:<psid>"), and the *real* external id lives
// in the new `socialId` / `externalUserId` columns below. WhatsApp code that
// only ever reads real phone numbers never sees or touches a social row.

/// One connected Facebook Page or Instagram Professional account.
model SocialAccount {
  id       String @id @default(cuid())
  tenantId String

  /// FACEBOOK | INSTAGRAM
  channel String

  /// Page ID (Facebook) or Instagram-scoped user id (Instagram Login).
  externalAccountId String
  name              String? // Page name / IG username
  username          String? // IG handle, null for Facebook
  profilePicUrl     String?

  /// Encrypted at rest (secret-box.ts). A long-lived Page token for Facebook;
  /// a long-lived Instagram user token for Instagram.
  accessToken    String
  tokenExpiresAt DateTime?

  webhookSubscribed Boolean @default(false)
  /// CONNECTED | ERROR | DISCONNECTED
  status    String  @default("CONNECTED")
  lastError String?

  /// The one active account per tenant per channel — a tenant may have
  /// connected more than one Page, but only one is live at a time.
  isActive Boolean @default(true)

  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, channel, externalAccountId])
  @@index([tenantId, channel])
  @@index([externalAccountId])
}

/// Per-tenant, per-channel automation configuration — DMs and comments
/// configured separately, per spec.
model SocialReplyJob {
  id String @id @default(cuid())
  tenantId String
  messageId String @unique
  accountId String
  recipientId String
  channel String
  kind String @default("DM")
  status String @default("WAITING")
  dueAt DateTime
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, status, dueAt])
}

model SocialAutomationSettings {
  id       String @id @default(cuid())
  tenantId String
  /// FACEBOOK | INSTAGRAM
  channel  String

  enabled              Boolean @default(false)
  dmAutoReplyEnabled   Boolean @default(true)
  commentAutoReplyEnabled Boolean @default(false)
  /// MANUAL_APPROVAL | AUTOMATIC | DRAFT_ONLY — same three modes as the
  /// Google review auto-reply engine, same reasoning.
  mode String @default("MANUAL_APPROVAL")
  /// AUTOMATIC only unlocks when the tenant OWNER explicitly turns it on —
  /// enforced server-side, not just a UI gate.
  fullyAutomaticConfirmedByOwner Boolean @default(false)

  tone       String  @default("professional")
  customTone String?

  businessHoursStart String? // "09:00"
  businessHoursEnd   String? // "18:00"
  timezone           String  @default("Asia/Muscat")
  replyDelaySeconds  Int     @default(0)

  dailyMessageLimit  Int @default(200)
  hourlyMessageLimit Int @default(40)

  welcomeMessage  String?
  awayMessage     String?
  fallbackReply   String?
  requireApproval Boolean @default(true)

  /// Services, prices, FAQs, hours, location, contact — the only facts the
  /// AI is allowed to answer from. Free-form JSON, rendered into the prompt,
  /// never invented beyond it.
  businessInfo       Json?
  customInstructions String?
  /// Extra escalation phrases beyond the hardcoded refund/legal/safety/
  /// discrimination/urgent set (mirrors review-reply-ai.ts).
  handoffKeywords Json?
  /// Words/topics the AI must never engage with — always escalated instead.
  excludedKeywords Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, channel])
}

/// A tenant-authored keyword -> canned reply rule, per channel. Deterministic
/// and free — checked before any AI call, the same precedence WhatsApp's own
/// bot flows already take over a generated reply.
model SocialKeywordReply {
  id       String @id @default(cuid())
  tenantId String
  channel  String // FACEBOOK | INSTAGRAM
  /// Comma-separated trigger phrases, matched case-insensitively as substrings.
  keywords String
  reply    String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, channel])
}

// ============================================================
// DIGITAL BUSINESS VCARD ADDON
// ============================================================

model BusinessVCard {
  id              String        @id @default(cuid())
  tenantId        String        @unique
  slug            String        @unique

  // Business Identity
  companyName     String        @default("My Business")
  title           String?
  tradeName       String?
  tagline         String?
  subtitle        String?
  industry        String?       @default("General")
  category        String?       @default("Business")
  shortBio        String?
  bio             String?
  aboutUs         String?
  yearEst         Int?
  businessType    String?       // LLC, Sole Proprietorship, Corporation, Partnership
  defaultLang     String        @default("en") // en | ar

  // Branding
  logoUrl         String?
  bannerUrl       String?
  coverType       String        @default("IMAGE") // IMAGE | VIDEO
  coverVideoUrl   String?
  serviceLayout   String        @default("SLIDER") // GRID | SLIDER
  profileUrl      String?
  primaryColor    String        @default("#059669")
  secondaryColor  String        @default("#0284c7")
  accentColor     String        @default("#10b981")
  themeMode       String        @default("system") // light, dark, system
  cardTemplate    String        @default("modern") // modern, executive, emerald, sunset, ocean, cyber, boutique, frost, artisan, brutalist
  buttonStyle     String        @default("rounded") // rounded, pill, square, neo3d, glass
  mediaConfig     Json?         // { coverHeight, coverPosition, coverFit, coverOverlay, coverBlur, logoSize, logoShape, logoFit, logoBorder, logoPosition, logoOverlap }

  // Primary Contact
  contactName     String?
  contactTitle    String?
  contactDept     String?
  mobileNumber    String?
  whatsappNumber  String?
  landlineNumber  String?
  email           String?
  altEmail        String?
  websiteUrl      String?

  // Address & Location
  addressLine1    String?
  addressLine2    String?
  building        String?
  street          String?
  area            String?
  city            String?
  state           String?
  postalCode      String?
  country         String?       @default("Oman")
  latitude        Float?
  longitude       Float?
  googleMapsUrl   String?

  // Social Channels & Custom URLs
  socialLinks     Json?
  customLinks     Json?         // [{ id, label, url, icon, iconType, highlight }]

  // Business Registration & Commercial
  crNumber        String?
  crExpiryDate    DateTime?
  vatNumber       String?
  legalName       String?
  isCrPublic      Boolean       @default(false)

  // Payments & Banking
  paymentUrl      String?
  amwalPayUrl     String?
  paymobUrl       String?
  bankName        String?
  accountName     String?
  accountNumber   String?
  iban            String?
  swiftCode       String?
  paymentNotes    String?
  showPaymentBtn  Boolean       @default(true)
  showBankDetails Boolean       @default(false)

  // Business Hours (JSON array of { day: 0..6, isOpen: bool, open1, close1, open2, close2 })
  businessHours   Json?
  timezone        String        @default("Asia/Muscat")
  holidayNotice   String?
  isHoliday       Boolean       @default(false)

  // Visibility Flags
  showEmail       Boolean       @default(true)
  showPhone       Boolean       @default(true)
  showWhatsapp    Boolean       @default(true)
  showAddress     Boolean       @default(true)
  showServices    Boolean       @default(true)
  showGallery     Boolean       @default(true)
  showHours       Boolean       @default(true)
  showLeadForm    Boolean       @default(true)

  // SEO & Verification
  metaTitle       String?
  metaDescription String?
  isVerified      Boolean       @default(false)

  // Status & Timestamps
  status          String        @default("DRAFT") // DRAFT, PUBLISHED, DISABLED
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           BusinessVCardItem[]
  gallery         BusinessVCardGalleryItem[]
  leads           BusinessVCardLead[]
  events          BusinessVCardAnalyticsEvent[]

  @@index([tenantId])
  @@index([slug])
  @@index([status])
}

model BusinessVCardItem {
  id              String        @id @default(cuid())
  tenantId        String
  cardId          String
  card            BusinessVCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type            String        @default("SERVICE") // SERVICE | PRODUCT
  name            String
  shortDesc       String?
  fullDesc        String?
  imageUrl        String?
  price           Decimal?      @db.Decimal(10, 3)
  salePrice       Decimal?      @db.Decimal(10, 3)
  currency        String        @default("OMR")
  pricePrefix     String?       // "Starts at", "From"
  priceSuffix     String?       // "per hour", "per day"
  sku             String?
  sortOrder       Int           @default(0)
  isFeatured      Boolean       @default(true)
  isActive        Boolean       @default(true)
  ctaLabel        String?       @default("Book via WhatsApp")
  whatsappMessage String?
  externalUrl     String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([cardId, isActive, sortOrder])
}

model BusinessVCardGalleryItem {
  id        String        @id @default(cuid())
  tenantId  String
  cardId    String
  card      BusinessVCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type      String        @default("IMAGE") // IMAGE | VIDEO
  url       String
  caption   String?
  altText   String?
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
  @@index([cardId, isActive, sortOrder])
}

model BusinessVCardAnalyticsEvent {
  id           String        @id @default(cuid())
  tenantId     String
  cardId       String
  card         BusinessVCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  eventType    String        // CARD_VIEW, QR_SCAN, WHATSAPP_CLICK, CALL_CLICK, EMAIL_CLICK, SAVE_CONTACT, WEBSITE_CLICK, MAP_CLICK, PAYMENT_CLICK, SOCIAL_CLICK, SERVICE_CLICK, SHARE_CLICK, LEAD_SUBMIT
  itemId       String?       // service or gallery id if applicable
  platform     String?       // instagram, linkedin, etc.
  referrer     String?
  sessionHash  String?
  deviceType   String?       // mobile, tablet, desktop
  browser      String?
  os           String?
  country      String?

  createdAt    DateTime      @default(now())

  @@index([tenantId, eventType, createdAt])
  @@index([cardId, eventType, createdAt])
  @@index([createdAt])
}

model BusinessVCardLead {
  id                String        @id @default(cuid())
  tenantId          String
  cardId            String
  card              BusinessVCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  name              String
  phone             String
  email             String?
  message           String?
  serviceInterested String?
  status            String        @default("NEW") // NEW, CONTACTED, CONVERTED, ARCHIVED

  // Synced CRM customer reference if found/created
  customerId        String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([cardId])
}

// ============================================================
// WEBSITE LIVE CHAT & WHATSAPP WIDGET ADDON
// ============================================================
model LiveChatWidget {
  id              String   @id @default(cuid())
  tenantId        String
  name            String   @default("Website Chat Widget")
  enabled         Boolean  @default(true)

  // Appearance & Branding
  primaryColor    String   @default("#00E785") // Fizmoh emerald/green
  position        String   @default("bottom-right") // bottom-right | bottom-left
  headerTitle     String   @default("Customer Support")
  headerSubtitle  String   @default("Typically replies in under 5 minutes")
  agentName       String   @default("Support Team")
  agentRole       String   @default("Customer Specialist")
  avatarUrl       String?
  welcomeMessage  String   @default("Hi there! 👋 How can we help you today?")
  proactivePrompt String?  @default("Need help? Chat with our team!")
  proactiveDelay  Int      @default(5) // in seconds

  // Channel Options
  whatsappEnabled Boolean  @default(true)
  whatsappNumber  String?  // e.g. +971501234567 or +968...
  whatsappMessage String?  @default("Hello! I have a question about your services.")

  webChatEnabled      Boolean  @default(true)
  requireLeadForm     Boolean  @default(true) // require name/email before chat
  requirePhone        Boolean  @default(false)
  enableAiAgent       Boolean  @default(true) // auto-reply to visitor questions via knowledge base
  enableSmartReplies  Boolean  @default(true) // AI smart reply suggestions for agents

  // Allowed Domains for CORS
  allowedDomains  Json?    // string[] e.g. ["example.com"]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
