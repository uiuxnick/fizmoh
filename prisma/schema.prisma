  tenantId  String?
  id        String   @id @default(cuid())
  staffId   String?
  customerId String?
  orderId   String?
  action    String   // APPROVE_PAYMENT, REJECT_PAYMENT, MODIFY_ORDER, CANCEL_ORDER, REFUND, etc.
  entity    String   // ORDER, PAYMENT, TOUR, etc.
  entityId  String
  details   Json?
  reason    String?
  ipAddress String?
  createdAt DateTime @default(now())

  staff    Staff?    @relation(fields: [staffId], references: [id])
  customer Customer? @relation("CustomerAuditLogs", fields: [customerId], references: [id])
  order    Order?    @relation("OrderAuditLogs", fields: [orderId], references: [id])
}

model ConsentLog {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id        String   @id @default(cuid())
  customerId String
  channel   String   // WHATSAPP, EMAIL
  type      String   // MARKETING, TRANSACTIONAL
  action    String   // OPT_IN, OPT_OUT
  source    String?  // WEBSITE, WHATSAPP, ADMIN
  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================
/// Configuration, per business and for the platform itself.
///
/// A null tenant means the row belongs to the installation rather than to any
/// one business — the APNs key, the Meta app secret, the platform's own
/// gateway. Those are ours; a WhatsApp token or an SMTP password is theirs.
model SystemSetting {
  id    String @id @default(cuid())
  // Empty string, not null, for a setting that belongs to the installation
  // rather than to a business. Postgres treats nulls in a unique index as
  // distinct, so a nullable column would let the same platform key be
  // inserted over and over; and a compound unique cannot be looked up by null
  // at all. The sentinel makes both work.
  tenantId String @default("")
  key   String
  value String
  type  String @default("STRING") // STRING, JSON, BOOLEAN, NUMBER
  category String @default("GENERAL") // GENERAL, PAYMENT, WHATSAPP, EMAIL, NOTIFICATION
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([key])
}

// ============================================================
// NOTIFICATIONS (internal alerts)
// ============================================================
/// A phone that has asked to be told about things.
///
/// One row per install, not per member of staff: somebody with a phone and an
/// iPad gets told on both, and a device that is handed over or signed out of
/// stops being told immediately.
model DeviceToken {
  id        String   @id @default(cuid())
  staffId   String
  /// The APNs or FCM token. Unique, because the same device re-registering
  /// must update its owner rather than accumulate rows that all ring at once.
  token     String   @unique
  platform  String   @default("IOS") // IOS, ANDROID
  /// Whether this token is for VoIP pushes, which use a different topic and a
  /// different token from ordinary notifications on iOS.
  kind      String   @default("ALERT") // ALERT, VOIP
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

model Notification {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id        String   @id @default(cuid())
  type      String   // NEW_BOOKING, PAYMENT_SUBMITTED, PAYMENT_APPROVED, LOW_CAPACITY, SLA_BREACH, etc.
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  forRole   String?  // target role
  forStaffId String?
  createdAt DateTime @default(now())
}

/// A consultation or meeting, as distinct from a tour booking.
///
/// Tours have a slot, seats, pricing and a boat that leaves whether or not
/// anyone is late. An appointment has none of that: it is one party, at one
/// time, usually online. Forcing it through Order meant inventing a fake tour
/// and a fake slot for every enquiry, so it gets its own table.
model Appointment {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id            String   @id @default(cuid())
  reference     String   @unique
  name          String
  email         String?
  phone         String?
  service       String
  companyName   String?
  companyWebsite String?
  notes         String?
  scheduledAt   DateTime
  durationMins  Int      @default(30)
  status        String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  /// Google Meet URL, when one could be created or a room is configured.
  meetLink      String?
  /// Set once the calendar entry exists, so a retry updates rather than duplicates.
  calendarEventId String?
  source        String   @default("ADMIN") // ADMIN, WHATSAPP, WEB
  customerId    String?
  conversationId String?
  leadId        String?
  assignedStaffId String?
  reminderSentAt DateTime?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([scheduledAt])

  @@index([tenantId])
}

/// A request for help with an Oman visa.
///
/// Deliberately holds no passport number, no document scan and no date of
/// birth. Those are what an application actually needs, but collecting them
/// over WhatsApp puts identity documents in a chat log and in this database in
/// plain text. The enquiry captures enough to quote and advise; the documents
/// are collected later over a channel meant for them.
model VisaEnquiry {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id            String   @id @default(cuid())
  reference     String   @unique
  name          String
  nationality   String
  /// Where they are going. The old visaType described visas *into* Oman; this
  /// business assists with applications *out* of Oman, which is the opposite
  /// direction and a different set of questions.
  destination   String   @default("")
  /// TOURISM, BUSINESS, FAMILY_VISIT, OTHER
  purpose       String   @default("TOURISM")
  /// Residency changes which consulate applies and what evidence is needed,
  /// so it is asked rather than assumed.
  omanResident  Boolean?
  /// APPLY, REQUIREMENTS, PRICING, STATUS, CONSULTANT, OTHER
  enquiryType   String   @default("APPLY")
  visaType      String   @default("UNSURE")
  travellers    Int      @default(1)
  arrivalDate   DateTime?
  stayNights    Int?
  email         String?
  phone         String?
  notes         String?
  /// NEW, DOCS_RECEIVED, IN_PREPARATION, SUBMITTED, APPROVED, DOCS_REQUIRED, CLOSED
  ///
  /// Deliberately no "rejected". A refusal is the embassy's decision and is
  /// recorded in the notes; a status that reads as though the agency refused
  /// somebody would be both wrong and repeated back to them.
  status        String   @default("NEW")
  quotedAmount  Float?
  assignedStaffId String?
  source        String   @default("WHATSAPP") // WHATSAPP, ADMIN, WEB
  customerId    String?
  conversationId String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([createdAt])

  @@index([tenantId])
}

/// Something the assistant is allowed to answer from: a pasted policy, an
/// uploaded document, a crawled page, an FAQ entry.
model KnowledgeSource {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id          String   @id @default(cuid())
  title       String
  /// TEXT, FILE, URL, SITE, FAQ
  type        String
  url         String?
  /// READY, INDEXING, ERROR
  status      String   @default("INDEXING")
  error       String?
  charCount   Int      @default(0)
  chunkCount  Int      @default(0)
  /// Kept so a re-crawl can tell an unchanged page from a changed one.
  contentHash String?
  lastIndexedAt DateTime?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([type])
  @@index([status])
}

/// A passage small enough to hand to the model, with its embedding.
///
/// Embeddings are a plain float array rather than a pgvector column, because
/// the extension is not installed on this server. At the scale a tour operator
/// actually has — hundreds to low thousands of passages — scanning them in
/// process costs a few milliseconds, and pretending otherwise would mean
/// asking for a database migration nobody needs yet.
model KnowledgeChunk {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id        String   @id @default(cuid())
  sourceId  String
  content   String
  ordinal   Int      @default(0)
  /// Where this passage came from, so an answer can cite it.
  heading   String?
  url       String?
  embedding Float[]
  createdAt DateTime @default(now())

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])

  @@index([tenantId])
}


/// An invitation to join a workspace.
///
/// Adding a colleague meant typing a password on their behalf and then telling
/// it to them — over WhatsApp, usually, where it stays forever. An invitation
/// lets them set their own, and lets the workspace see who has been asked and
/// has not yet arrived.
model Invitation {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  name       String?
  /// The workspace role they get on arrival, not their global staff role.
  role       String   @default("CHAT_AGENT")
  /// Random, single-use, and the only thing that proves the invitation.
  token      String   @unique
  invitedBy  String?
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([tenantId, acceptedAt])
  @@index([email])
}


// ============================================================
// RESTAURANT & DINING MODULE
// ============================================================

// ============================================================
// RESTAURANT & DINING MODULE (Smart Menu & Table Ordering)
// ============================================================

model RestaurantBranch {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  nameAr            String?
  slug              String
  code              String?
  businessType      String   @default("RESTAURANT") // RESTAURANT, CAFE, HOTEL, RESORT, LOUNGE, FOOD_COURT, CLOUD_KITCHEN, ROOM_SERVICE
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  city              String?
  lat               Float?
