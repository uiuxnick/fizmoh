  /// Unique per business — "WELCOME10" belongs to whoever issued it.
  code        String
  type        String   // PERCENTAGE, FIXED
  value       Float
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean  @default(true)
  applicableTours Json? // [tourId] or null for all
  minOrderAmount Float?
  createdAt   DateTime @default(now())

