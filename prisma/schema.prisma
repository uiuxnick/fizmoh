  appointments     AptAppointment[]

  @@index([tenantId, status])
}

model AptProviderService {
  id          String   @id @default(cuid())
  tenantId    String
  providerId  String
  serviceId   String

  provider    AptProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service     AptService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@index([tenantId])
}

model AptSchedule {
  id           String   @id @default(cuid())
  tenantId     String
  providerId   String
  dayOfWeek    Int      // 0=Sun, 1=Mon, ..., 6=Sat
  isWorkingDay Boolean  @default(true)
  shiftsJson   String   @default("[{\"start\":\"09:00\",\"end\":\"17:00\"}]")
  breaksJson   String   @default("[]")

  provider     AptProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek])
  @@index([tenantId])
}

model AptLeave {
  id          String   @id @default(cuid())
  tenantId    String
  providerId  String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  createdAt   DateTime @default(now())

  provider    AptProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([tenantId, providerId])
}

model AptAppointment {
  id              String   @id @default(cuid())
  tenantId        String
  reference       String   @unique
  customerId      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  serviceId       String
  providerId      String?
  branchId        String?
  appointmentDate DateTime
  startTime       String   // e.g. "10:00"
  endTime         String   // e.g. "10:30"
  durationMins    Int      @default(30)
  status          String   @default("CONFIRMED") // HELD, PENDING_PAYMENT, PENDING_CONFIRMATION, CONFIRMED, CHECKED_IN, IN_PROGRESS, COMPLETED, CANCELLED, RESCHEDULED, NO_SHOW, EXPIRED
  paymentStatus   String   @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, PAID, FAILED, REFUNDED
  paymentMethod   String?
  totalAmount     Float    @default(0)
  bookingSource   String   @default("WHATSAPP") // WHATSAPP, WEBSITE, ADMIN, MANUAL, API
  notes           String?
  conversationId  String?
  meetLink        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  service         AptService   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  provider        AptProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  branch          AptBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  history         AptHistory[]
  answers         AptAnswer[]
  reminders       AptReminder[]

  @@index([tenantId, appointmentDate])
  @@index([tenantId, status])
  @@index([customerPhone])
}

model AptHistory {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  statusFrom    String?
  statusTo      String
  notes         String?
  changedBy     String   @default("SYSTEM") // SYSTEM, CUSTOMER, ADMIN
  createdAt     DateTime @default(now())

  appointment   AptAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AptHold {
  id            String   @id @default(cuid())
  tenantId      String
  serviceId     String
  providerId    String?
  branchId      String?
  slotDate      DateTime
  startTime     String
  endTime       String
  customerPhone String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, slotDate])
  @@index([expiresAt])
}

model AptWaitlist {
  id            String   @id @default(cuid())
  tenantId      String
  serviceId     String
  providerId    String?
  branchId      String?
  customerName  String
  customerPhone String
  preferredDate DateTime?
  preferredTime String?
  status        String   @default("WAITING") // WAITING, NOTIFIED, BOOKED, EXPIRED, CANCELLED
  createdAt     DateTime @default(now())

  @@index([tenantId, status])
}

model AptReminder {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  reminderType  String   // 24H, 2H, 30M
  scheduledFor  DateTime
  status        String   @default("PENDING") // PENDING, SENT, FAILED
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  appointment   AptAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
}

model AptCustomField {
  id          String   @id @default(cuid())
  tenantId    String
  serviceId   String
  label       String
  fieldType   String   @default("TEXT") // TEXT, NUMBER, YES_NO, SINGLE_CHOICE, MULTI_CHOICE, DATE
  required    Boolean  @default(false)
  optionsJson String?  // Array of options for choice fields
  sortOrder   Int      @default(0)

  service     AptService  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  answers     AptAnswer[]

  @@index([serviceId])
}

model AptAnswer {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  customFieldId String
  answerValue   String

  appointment   AptAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customField   AptCustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model AptBookingSession {
  id            String   @id @default(cuid())
  tenantId      String
  customerPhone String
  conversationId String?
  step          String   // SERVICE, PROVIDER, BRANCH, DATE, TIME, CONFIRM
  dataJson      String   @default("{}")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, customerPhone])
  @@index([expiresAt])
}

model AptSettings {
  id                        String   @id @default(cuid())
  tenantId                  String   @unique
  isEnabled                 Boolean  @default(true)
  defaultTimezone           String   @default("Asia/Muscat")
  autoConfirm               Boolean  @default(true)
  cancellationDeadlineHours Int      @default(24)
  cancellationPolicyText    String?
  reminder24h               Boolean  @default(true)
  reminder2h                Boolean  @default(true)
  reminder30m               Boolean  @default(false)
