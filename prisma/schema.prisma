// ============================================================
// WHATSAPP & EMAIL TEMPLATES
// ============================================================
model Template {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id              String   @id @default(cuid())
  channel         String   // WHATSAPP, EMAIL
  name            String
  category        String   // MARKETING, UTILITY, AUTHENTICATION
  language        String   @default("en_US")
  type            String   // TEXT, MEDIA, INTERACTIVE
  headerType      String?  // NONE, TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent   String?
  bodyContent     String
  footerContent   String?
  buttons         Json?    // [{type, text, url/phone}]
  // Carousel cards: [{ imageUrl, body, buttons: [{type, text, url}] }]
  // Meta requires every card to share the same structure, so this is stored
  // as one list and validated as a set rather than per card.
  cards           Json?
  variables       Json?    // [string]
  emailSubject    String?
  emailHtml       String?  // for email templates
  status          String   @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  metaTemplateId  String?  // WhatsApp template ID from Meta
  rejectionReason String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns Campaign[]

  @@index([tenantId])
}

// ============================================================
// CAMPAIGNS / BROADCASTS
// ============================================================
model Campaign {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id           String   @id @default(cuid())
  name         String
  channel      String   // WHATSAPP, EMAIL
  templateId   String?
  segmentId    String?
  subject      String?  // email
  customContent String?
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED
  totalSent    Int      @default(0)
  totalDelivered Int    @default(0)
  totalRead    Int      @default(0)
  totalClicked Int      @default(0)
  totalBounced Int      @default(0)
  totalOptOut  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lastError    String?
  startedAt    DateTime?

  /// Which value fills each of the template's {{1}}, {{2}}… placeholders.
  /// Tokens like "customer.name" are resolved per recipient; anything else is
  /// sent as written. Without this every campaign sent one value — the name —
  /// whatever the template actually asked for, and Meta rejected the rest.
  variableMap  Json?
  /// The header image, video or document a media template needs. Meta fetches
  /// it, so it has to be a public URL rather than a path.
  headerMediaUrl String?
  headerMediaType String?
  /// Where a tracked link should land. Clicks are counted through a redirect
  /// rather than guessed.
  linkUrl      String?
  /// Messages per second. Meta throttles per number and downgrades quality
  /// for a sender that ignores it.
  ratePerSecond Int     @default(10)
  /// Set while a send is running so an operator can stop one that is wrong.
  cancelledAt  DateTime?
  pausedAt     DateTime?
  /// Marketing outside these hours is a complaint waiting to happen.
  respectQuietHours Boolean @default(true)
  totalFailed  Int      @default(0)

  template   Template? @relation(fields: [templateId], references: [id])
  segment    Segment?  @relation(fields: [segmentId], references: [id])
  recipients CampaignRecipient[]

  @@index([tenantId])
}

// One row per customer per campaign. Makes sends idempotent (a retried or
// re-run campaign never messages the same person twice) and gives per-recipient
// delivery analytics per BRD §6.5.3.
model CampaignRecipient {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id           String   @id @default(cuid())
  campaignId   String
  customerId   String
  phone        String
  status       String   @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  skipReason   String?  // OPTED_OUT, NO_PHONE, OUTSIDE_SESSION_NO_TEMPLATE
  error        String?
  externalId   String?  // WhatsApp message id
  sentAt       DateTime?
  /// How many times sending to this person has been attempted. A transient
  /// failure is worth retrying; a rejected number is not, and without a count
  /// the two are indistinguishable.
  attempts     Int      @default(0)
  deliveredAt  DateTime?
  readAt       DateTime?
  clickedAt    DateTime?
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

model Segment {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id           String   @id @default(cuid())
  name         String
  channel      String   // WHATSAPP, EMAIL, BOTH
  filterRules  Json?    // [{field, op, value}]
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaigns Campaign[]
}

// ============================================================
// BOT / AUTOMATION FLOWS
// ============================================================
/// A WhatsApp number this platform can send from.
///
/// The settings screen holds one set of credentials, pasted in by hand. That
/// is fine for one number and impossible for onboarding anybody else's, which
/// is what Embedded Signup exists to do — so a connected number is a row, and
/// the credentials belong to it rather than to the installation.
model WhatsAppAccount {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id             String   @id @default(cuid())
  /// Meta's ids. The pair that identifies a number: the business account it
  /// belongs to, and the number itself.
  wabaId         String
  phoneNumberId  String   @unique
  businessId     String?
  displayPhone   String?
  verifiedName   String?
  /// Encrypted at rest. A token in the clear is an account somebody else can
  /// send from.
  accessToken    String
  /// GREEN, YELLOW, RED or UNKNOWN — Meta's own words for how a number is
  /// behaving.
  qualityRating  String?
  /// TIER_250, TIER_1K, TIER_10K, TIER_100K, UNLIMITED.
  messagingLimit String?
  /// VERIFIED, NOT_VERIFIED, EXPIRED.
  codeVerification String?
  platformType   String?
  throughput     String?
  status         String   @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  lastError      String?
  /// EMBEDDED_SIGNUP or MANUAL — worth knowing when a token stops working.
  connectedVia   String   @default("MANUAL")
  /// The number new messages go out from when nothing says otherwise.
  isDefault      Boolean  @default(false)
  webhookSubscribed Boolean @default(false)
  registered     Boolean  @default(false)
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([wabaId])
}

model BotScheduleDispatch {
  id String @id @default(cuid())
  tenantId String
  flowId String
  conversationId String
  scheduledAt DateTime
  status String @default("CLAIMED")
  createdAt DateTime @default(now())
  @@unique([flowId, conversationId, scheduledAt])
}

model BotFlow {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id          String   @id @default(cuid())
  name        String
  description String?
  trigger     String   // KEYWORD, INTENT, NEW_CONVERSATION, SCHEDULE
  triggerConfig Json?  // keywords, intents, schedule
  nodes       Json?    // flow builder nodes
  edges       Json?    // flow builder edges
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  /// The version people are talking to. Editing a live flow underneath a
  /// customer half way through it is how somebody gets asked question four of
  /// a form that no longer exists.
  version     Int      @default(1)
  publishedAt DateTime?
  /// The last published copy, so a bad edit is one click to undo.
  publishedNodes Json?
  publishedEdges Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        FlowRun[]

  @@index([tenantId])
}

/// One customer's journey through one flow.
///
/// Kept because a flow that nobody finishes looks identical to a flow nobody
/// starts, unless somebody counts. It is also the delay queue: a flow waiting
/// on a timer is a run with a resumeAt in the future.
model FlowRun {
  /// Which business this row belongs to. Nullable until every writer
  /// supplies it; see the tenancy note above.
  tenantId  String?
  id             String   @id @default(cuid())
  flowId         String
  conversationId String
  customerId     String?
  status         String   @default("RUNNING") // RUNNING, WAITING, DONE, HANDOFF, FAILED
  currentNodeId  String?
  /// Answers and variables collected so far.
  variables      Json?
  /// Which nodes were reached, for the counts shown on the canvas.
  path           Json?
  /// When a delay node's wait is over.
  resumeAt       DateTime?
  error          String?
  startedAt      DateTime @default(now())
  endedAt        DateTime?

  flow BotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status, resumeAt])
}

