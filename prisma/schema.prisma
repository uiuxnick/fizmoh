model RestaurantMenu {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  name          String
  nameAr        String?
  description   String?
  type          String   @default("DINE_IN") // DINE_IN, ROOM_SERVICE, BREAKFAST, LUNCH, DINNER, DRINKS, DESSERT
  isActive      Boolean  @default(true)
  isPublished   Boolean  @default(true)
  sortOrder     Int      @default(0)
  availableDays String?  // e.g. "mon,tue,wed,thu,fri,sat,sun"
  availableFrom String?  // e.g. "08:00"
  availableTo   String?  // e.g. "23:00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  categories    MenuCategory[]

  @@index([tenantId, branchId])
}

model RestaurantTable {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String?
  number          String
  name            String?
  capacity        Int      @default(4)
  section         String   @default("MAIN") // MAIN, TERRACE, VIP, PATIO, BAR
  area            String   @default("INDOOR") // INDOOR, OUTDOOR, TERRACE, VIP, FLOOR_1, FLOOR_2, ROOM, BEACH, POOL
  type            String   @default("TABLE") // TABLE, ROOM
  roomNumber      String?
  token           String?  // Secure public QR code token
  status          String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, DIRTY, BILL_REQUESTED
