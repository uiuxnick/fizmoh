  appointments       AptAppointment[]

  @@index([tenantId, status])
}

model AptBranch {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  address     String?
  phone       String?
  mapsUrl     String?
  hoursJson   String?  // Weekly hours override
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments AptAppointment[]

  @@index([tenantId])
}

model AptProvider {
  id          String   @id @default(cuid())
  tenantId    String
  staffId     String?  // Optional relation to Staff
  name        String
  photoUrl    String?
  role        String   @default("Provider")
  specialty   String?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices AptProviderService[]
  schedules        AptSchedule[]
